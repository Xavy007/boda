# ── Base de datos (Supabase → Project Settings → Database → Connection string) ──
# Pooler en modo "Transaction" (puerto 6543). Lo usa la app en tiempo de ejecución.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexión directa (puerto 5432). La usa Prisma para las migraciones.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Seguridad (genera valores con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ──
JWT_SECRET="cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres"
COOKIE_SECRET="cambia-esto-por-otro-secreto-largo-de-al-menos-32-caracteres"

# URL pública del frontend (en producción, el mismo dominio donde corre Express)
CLIENT_URL="http://localhost:5173"
PORT=4000

# Carpeta donde se guardan las fotos subidas desde el panel (por defecto: ./media en la raíz).
# En Render/Railway debe ser un disco persistente, p. ej. /var/data/media
# MEDIA_DIR="/var/data/media"

# ── Admin inicial (solo lo usa el seed) ──
SEED_ADMIN_EMAIL="novios@ejemplo.com"
SEED_ADMIN_PASSWORD="CambiaEstaClave2027!"
