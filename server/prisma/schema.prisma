// Prisma + Supabase (PostgreSQL)
// La base guarda solo invitaciones, invitados, dispositivos, accesos y la configuración.
// Las fotos viven en Supabase Storage (bucket `fotos`); la tabla Photo guarda su orden y descripción.
// - DATABASE_URL: pooler (6543, pgbouncer=true) para las consultas de la app
// - DIRECT_URL:   conexión directa (5432) para las migraciones

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InvitationStatus {
  PENDIENTE
  CONFIRMADO
  RECHAZADO
}

model Invitation {
  id             String           @id @default(cuid())
  token          String           @unique
  familyName     String
  /// Invitación a una persona (no a una familia); si tiene más de 1 cupo, va con acompañante
  isPerson       Boolean          @default(false)
  side           GuestSide?
  contactPhone   String?
  contactEmail   String?
  maxGuests      Int              @default(2)
  maxDevices     Int              @default(2)
  status         InvitationStatus @default(PENDIENTE)
  sentAt         DateTime?
  firstOpenedAt  DateTime?
  confirmedAt    DateTime?
  /// Nombre de la persona que respondió el RSVP
  respondentName String?
  /// Cantidad de personas que asisten (0 si no asisten o no respondieron)
  attendingCount Int              @default(0)
  dietaryNotes   String?
  message        String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  devices    InvitationDevice[]
  accessLogs AccessLog[]

  @@index([status])
}

model InvitationDevice {
  id              String     @id @default(cuid())
  invitationId    String
  invitation      Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  deviceId        String
  fingerprintHash String?
  firstSeen       DateTime   @default(now())
  lastSeen        DateTime   @default(now())

  @@unique([invitationId, deviceId])
  @@index([invitationId, fingerprintHash])
}

model AccessLog {
  id              String      @id @default(cuid())
  invitationId    String?
  invitation      Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  ip              String?
  userAgent       String?
  fingerprintHash String?
  allowed         Boolean
  reason          String?
  createdAt       DateTime    @default(now())

  @@index([invitationId, createdAt])
  @@index([allowed, createdAt])
}

/// Una sola fila (id = 1)
model EventSettings {
  id             Int       @id @default(1)
  partnerOneName String
  partnerTwoName String
  /// Nombres de los padres de cada novio, p. ej. "Juan Pérez y María López"
  partnerOneParents String?
  partnerTwoParents String?
  /// Muestra una nota discreta en el RSVP: celebración solo para adultos
  adultsOnly Boolean @default(false)
  eventDate      DateTime
  eventEndDate   DateTime?
  timezone       String    @default("America/La_Paz")

  ceremonyName    String
  ceremonyAddress String
  ceremonyMapsUrl String?

  receptionName    String
  receptionAddress String
  receptionTime    String?
  receptionMapsUrl String?

  dressCode       String
  dressCodeNote   String?

  mainPhrase    String
  quotePhrase   String?
  quoteAuthor   String?
  closingPhrase String?

  rsvpDeadline     DateTime
  /// Cupos por defecto al crear o importar invitaciones sin cupos indicados
  defaultMaxGuests Int      @default(2)
  /// { message, registryName, registryUrl, bankName, accountHolder, accountNumber, accountType, documentId, alias }
  giftInfo         Json     @default("{}")

  couplePhone      String
  whatsappTemplate String

  /// { ivory, sage, gold, ink }
  palette  Json    @default("{}")
  musicUrl String?

  /// [{ date, title, text }]
  storyItems Json @default("[]")
  /// [{ time, title, description, icon }]
  itinerary  Json @default("[]")

  updatedAt DateTime @updatedAt
}

/// ADMIN: administrador (todo el panel) · PLANNER: wedding planner (confirmaciones, enviar links y reporte)
/// NOVIA / NOVIO: solo cargan familias, teléfonos y datos de contacto; sus invitaciones quedan de su lado
enum AdminRole {
  ADMIN
  PLANNER
  NOVIA
  NOVIO
}

/// De qué lado es el invitado, para el reporte por novia y novio
enum GuestSide {
  NOVIA
  NOVIO
  AMBOS
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now())
  /// Las sesiones iniciadas antes de esta fecha dejan de valer
  passwordChangedAt DateTime?
}

/// Fotos de la invitación. Los archivos (WebP) viven en Supabase Storage (bucket `fotos`);
/// aquí solo se guarda la sección, el orden, la descripción y las URLs.
model Photo {
  id          String   @id
  section     String
  order       Int      @default(0)
  alt         String   @default("")
  width       Int
  height      Int
  blurDataUrl String?
  /// [{ width, url, path }]
  variants    Json
  createdAt   DateTime @default(now())

  @@index([section, order])
}
